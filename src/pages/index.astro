---
import { Image } from 'astro:assets';
import Base from '../layouts/Base.astro';
import avatar from '../assets/avatar.jpg';

interface Notebook {
  name: string;
  href: string;
  host: string;
  text: string;
  /** Pen colour for the card's top edge and labels. */
  pen: 'red' | 'blue' | 'green';
  /** Set true to keep a notebook off the page for now. */
  hidden?: boolean;
}

const notebooks: Notebook[] = [
  {
    name: 'DevOps',
    href: 'https://devops.tigonguyen.com',
    host: 'devops.tigonguyen.com',
    text: 'Notes and labs on cloud infrastructure, Kubernetes, CI/CD and security.',
    pen: 'red',
  },
  {
    name: 'LLM Security',
    href: 'https://llmsec.tigonguyen.com',
    host: 'llmsec.tigonguyen.com',
    text: 'The LLM Security Atlas: papers on how language models are attacked and defended, placed on one map.',
    pen: 'blue',
  },
  {
    name: 'Học Nhi Tri',
    href: 'https://tigonguyen.substack.com',
    host: 'tigonguyen.substack.com',
    text: 'My Substack, in Vietnamese.',
    pen: 'green',
    hidden: true,
  },
];

const shown = notebooks.filter((n) => !n.hidden);
const pens = {
  red: { edge: 'border-t-red', text: 'text-red' },
  blue: { edge: 'border-t-blue', text: 'text-blue' },
  green: { edge: 'border-t-green', text: 'text-green' },
};
const counts = ['', 'one so far', 'two so far', 'three so far', 'four so far'];
---

<Base>
  <section class="mb-14 flex flex-wrap items-center gap-11">
    <div class="relative flex-none -rotate-2">
      <Image
        src={avatar}
        alt="Thanh Nguyen"
        width={360}
        height={420}
        loading="eager"
        class="block h-[210px] w-[180px] border-[10px] border-card object-cover shadow-[0_6px_18px_rgba(31,42,68,0.18)]"
      />
      <span aria-hidden="true" class="absolute -top-3 left-[60px] h-6 w-20 rotate-[4deg] bg-[rgba(255,227,110,0.75)]"></span>
    </div>
    <div class="flex min-w-0 flex-[1_1_480px] flex-col gap-4">
      <h1 class="text-5xl leading-[1.02] font-bold tracking-tight sm:text-[72px]">Hi, I'm Thanh Nguyen.</h1>
      <p class="text-2xl leading-snug sm:text-[26px]">I keep notes on <span class="mark">more than one thing</span>.</p>
      <p class="max-w-xl text-lg leading-relaxed text-soft">Each interest gets its own notebook online. Open one below.</p>
    </div>
  </section>

  <section aria-labelledby="notebooks" class="flex flex-col gap-5">
    <div class="flex flex-wrap items-baseline gap-3.5">
      <h2 id="notebooks" class="text-[15px] font-bold tracking-[0.1em] uppercase">Notebooks</h2>
      <span class="font-hand text-2xl text-red">{counts[shown.length] ?? `${shown.length} so far`}, more coming ↓</span>
    </div>
    <ul class="grid gap-7 md:grid-cols-2">
      {shown.map((n, i) => (
        <li>
          <a
            href={n.href}
            class:list={[
              'ruled flex h-full flex-col gap-3 border-t-4 bg-card px-7 pt-7 pb-6 shadow-[0_2px_0_rgba(31,42,68,0.08),0_10px_24px_rgba(31,42,68,0.08)] transition-transform hover:-translate-y-1',
              pens[n.pen].edge,
            ]}
          >
            <span class:list={['font-hand text-[22px]', pens[n.pen].text]}>No. {i + 1}</span>
            <span class="text-[38px] leading-tight font-bold tracking-tight">{n.name}</span>
            <span class="text-[17px] leading-relaxed text-soft">{n.text}</span>
            <span class:list={['mt-auto text-[15px] font-medium', pens[n.pen].text]}>{n.host} →</span>
          </a>
        </li>
      ))}
    </ul>
  </section>
</Base>
