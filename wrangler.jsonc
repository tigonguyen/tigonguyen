// Cloudflare Workers static-assets deploy for tigonguyen.com.
// `npm run build` writes the site to dist/; `npx wrangler deploy` uploads it.
{
  "name": "home",
  "compatibility_date": "2026-10-01",
  "routes": [{ "pattern": "tigonguyen.com", "custom_domain": true }],
  "assets": {
    "directory": "./dist",
    "not_found_handling": "404-page"
  }
}
